# ================================================================
# Ankit Da Mess — Required Environment Variables
# ================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.

# ------------------------------------------------
# Site
# ------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ankitdamess.in
NEXT_PUBLIC_SITE_NAME=Ankit Da Mess
NODE_ENV=development

# ------------------------------------------------
# Database (MongoDB Atlas — Phase 4)
# ------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ankitdamess?retryWrites=true&w=majority
DB_NAME=ankitdamess_dev

# ------------------------------------------------
# Auth (Phase 4)
# ------------------------------------------------
JWT_SECRET=generate-with-node-crypto-randomBytes-48-hex-min-96chars
INITIAL_ADMIN_EMAIL=owner@ankitdamess.in
INITIAL_ADMIN_PASSWORD=ChangeMe-12chars-Min

# ------------------------------------------------
# Cloudinary (Phase 4 — media uploads)
# ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# ------------------------------------------------
# Transactional Email (Phase 3 — Contact form)
# ------------------------------------------------
RESEND_API_KEY=
CONTACT_FORM_RECIPIENT=bookings@ankitdamess.in

# ------------------------------------------------
# Google Maps (Phase 2)
# ------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------
# Analytics (Phase 5)
# ------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ID=
